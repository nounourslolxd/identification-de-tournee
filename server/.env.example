# Nom de domaine public du serveur (doit pointer vers cette machine, ports 80 et 443 ouverts)
DOMAIN=ocr.exemple.be
# Adresse de l'application (GitHub Pages), seule autorisée à appeler le serveur
# L'APK Android appelle depuis https://localhost : ajoutez-le pour que l'application installée fonctionne.
ALLOWED_ORIGINS=https://utilisateur.github.io,https://localhost
# Projet Supabase : sert à vérifier que l'appelant est un facteur connecté (clé anon uniquement)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Modèle de vision (Ollama, vLLM, llama.cpp… toute API compatible OpenAI)
VISION_MODEL=qwen2.5vl:7b
# VISION_URL=http://localhost:11434/v1     (fixé par docker-compose)
# VISION_API_KEY=                          (si votre serveur de modèle en exige une)
# VISION_TIMEOUT_MS=60000
# VISION_KEEPALIVE_MIN=4                   (le modèle reste en mémoire : pas d'attente à la première lettre ; 0 = désactivé)
# SECOND_PASS=1                            (0 = pas de 2e lecture quand plusieurs rues sont possibles)
# RATE_PER_MINUTE=30
# Code d'accès partagé (au moins 12 caractères) : à saisir dans les réglages de l'application sur chaque téléphone.
# Suffit sans Supabase. Générez-le au hasard, ne le mettez jamais dans le dépôt.
# ACCESS_CODE=
# ALLOW_ANONYMOUS=1                        (essai en réseau local uniquement, sans Supabase)
